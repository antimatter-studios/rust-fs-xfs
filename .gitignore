# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# VM harness scratch (per-VM Vagrant state, cached boot assets).
# The harness keeps its machine directory outside the repository; what is
# left here is whatever an older checkout produced. Re-runnable, never in
# source control.
.qemu/
**/.vagrant/
.claude/
# VM harness shared dir (the fixtures, and the files one guest call
# leaves behind). Built by `chore fixtures`, large, and regenerable.
.vm-share/

# Test scratch and the tier logs. scripts/with-test-temp.sh puts every
# test's scratch directory in here rather than in /tmp, because the
# oracle tools run in the harness guest, which sees this repository and
# nothing else of the host; scripts/tier.sh writes tmp/logs/<tier>.log.
tmp/

# chore fingerprint cache (sources:/generates: checksums). Derived data.
.chore/

# Build output. `chore staticlib` writes the archive and headers here for a
# consumer to copy out of (`chore artifact` prints this directory).
/dist/

# Scratch logs from a run somebody watched.
/tmp-*.log
